{
  "name": "teatro-cscsp-gestao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulador": "vite --mode emulador",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-teatro-cscsp",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "admin:criar": "node scripts/criar-admin.mjs",
    "dados:teste": "node scripts/dados-teste.mjs",
    "deploy:regras": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "firebase-admin": "^13.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
